# 로컬 개발: 이 파일을 .env.local로 복사해서 쓰고, docker-compose(테스트 Mongo/LocalStack)
# 기준 기본값을 그대로 쓰면 됨.
# 배포용: 이 파일을 .env로 복사해서 terraform/README.md의 "최초 배포" 단계에 나오는 실제
# 값(terraform output)으로 채운 뒤 EC2로 scp할 것 — 이 파일 자체엔 실제 비밀값을 절대 넣지 않는다.

# mongoDB — 로컬은 docker-compose의 테스트 Mongo, 배포는 terraform output "atlas_connection_string"
MONGODB_URI=mongodb://localhost:27018

# Redis — 로컬은 localhost, 배포는 docker-compose.yml이 REDIS_HOST=redis로 덮어씀(신경 안 써도 됨)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT — 배포용은 로컬 값을 재사용하지 말고 새로 생성할 것(예: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS / Cookie — 로컬은 http+false, 배포는 반드시 https 도메인 + true
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# S3 — 배포에서만 필요(EC2는 인스턴스 역할로 자동 인증되므로 키 불필요). terraform/variables.tf의
# aws_region과 동일하게 맞출 것
AWS_REGION=ap-northeast-2
