# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI에 아래를 추가해야 함: http://localhost:5173/login, https://mixxtopia.site/login
VITE_GOOGLE_CLIENT_ID=

# Naver Developers > 내 애플리케이션 > Client ID
# Callback URL에 아래를 추가해야 함: http://localhost:5173/login, https://mixxtopia.site/login
VITE_NAVER_CLIENT_ID=
