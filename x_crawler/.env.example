# docker-compose.yml(로컬 Mongo + LocalStack S3) 기준 기본값. 그대로 복사해서 .env로 써도 됨.
# 실제 mixxtopia 서버(Atlas/S3)에 바로 적재하고 싶을 때만 이 값들을 교체.

MONGODB_URI=mongodb://localhost:27018
MONGODB_DB=mixxtopia

S3_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1
S3_BUCKET=mixxtopia-media
# 비워두면 S3_ENDPOINT_URL/S3_BUCKET으로 자동 생성(path-style).
# 프로덕션에서는 CloudFront 도메인으로 교체.
S3_PUBLIC_BASE_URL=
